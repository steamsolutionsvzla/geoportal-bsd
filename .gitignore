# =============================================================
# .gitignore - Geoportal BSD (Astro + FastAPI + GeoServer + Docker)
# =============================================================

# ---------- Secretos y variables de entorno ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# ---------- Docker / despliegue (no subir) ----------
docker-compose.yml
docker-compose.yaml
docker-compose.*.yml
docker-compose.*.yaml
compose.yml
compose.yaml
!docker-compose.example.yml
frontend/Dockerfile
frontend/.dockerignore
frontend/nginx.conf
backend/Dockerfile
backend/.dockerignore

# ---------- GeoServer (datos, logs y credenciales) ----------
geoserver_data/
# Solo se versiona la plantilla de Docker Compose de GeoServer
geoserver/*
!geoserver/docker-compose.example.yml

# ---------- Backend (Python / FastAPI) ----------
backend/app/config.py
# backend/app/config/    <- descomentar solo si esa carpeta contiene secretos
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
*.sqlite
*.sqlite3
*.db

# ---------- Frontend (Astro / pnpm) ----------
node_modules/
.pnpm-store/
dist/
.astro/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Volúmenes de base de datos local ----------
pgdata/
postgres_data/

# ---------- Logs y temporales ----------
logs/
*.log
tmp/
*.tmp
*.bak
*.swp
*.swo
*~

# ---------- Editor / sistema operativo ----------
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---------- Artefactos locales ----------
frontend/tiles-generate.err

# ---------- Mapa offline del geoportal ----------
# Tiles generados con frontend/scripts/generate-offline-tiles.py
frontend/public/tiles/
frontend/tiles-generate.log

# ---------- Agentes / skills (no versionar) ----------
# Salidas y configuracion local de las skills de agentes
.archify/
video/
.agents/
.claude/
.cursor/
.windsurf/
.codex/
.gemini/
.dsh/
*.skill

