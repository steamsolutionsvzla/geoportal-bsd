---
import GeoportalLayout from '../layouts/GeoportalLayout.astro';
import 'maplibre-gl/dist/maplibre-gl.css';
import '@fontsource/fraunces/400.css';
import '@fontsource/fraunces/500.css';
import '@fontsource/fraunces/600.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../styles/config.css';
import '../styles/metadata-qgis.css';
---

<GeoportalLayout title="Personalizar Geoportal · BSD" bodyClass="config-body">
  <div class="cfg-shell">
    <header class="topbar">
      <div class="brand">
        <img src="/img/logo.png" alt="Banco Soberano de Datos de Petróleo y Gas" class="brand-logo" />
      </div>
      <div class="brand-text">
        <span class="name">Geoportal</span>
        <span class="cfg-brand-sub">Personalizar Geoportal</span>
      </div>

      <div class="topbar-actions">
        <a href="/geoportal" class="cfg-toplink">
          Ir al visor
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
        <a href="/hub" class="icon-btn" title="Volver al hub" aria-label="Volver al hub">
          <svg viewBox="0 0 24 24" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12l9-9 9 9"></path>
            <path d="M5 10v10h14V10"></path>
          </svg>
        </a>
        <button class="icon-btn logout-btn" title="Cerrar sesión" aria-label="Cerrar sesión" onclick="cerrarSesion()">
          <svg viewBox="0 0 24 24" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
        </button>
        <div class="user-chip" title="Sesión iniciada">
          <div class="user-info">
            <span class="u-name">—</span>
            <span class="u-role">—</span>
          </div>
          <div class="avatar">—</div>
        </div>
      </div>
    </header>

    <div class="cfg-workspace">
      <aside class="cfg-nav" aria-label="Capas del Geoportal">
        <div class="cfg-nav-head">
          <div>
            <span class="cfg-eyebrow">Capas del Geoportal</span>
            <span class="cfg-nav-count" id="cfgLayerCount">0 capas</span>
          </div>
          <a href="/analista-mapa" class="cfg-nav-link" title="Abrir el editor sobre el mapa">Editor en mapa</a>
        </div>

        <div class="cfg-search">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
            <circle cx="11" cy="11" r="7"></circle>
            <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
          </svg>
          <input type="search" id="cfgSearch" placeholder="Buscar capa o workspace…" autocomplete="off" />
        </div>

        <div class="cfg-nav-scroll" id="cfgLayerList">
          <p class="cfg-empty-mini">Cargando capas…</p>
        </div>

        <div class="cfg-nav-modules">
          <span class="cfg-nav-modules-title">Otros módulos</span>
          <a href="/admin/configuracion" class="cfg-module-link">
            <span>Usuarios y roles</span>
            <span class="cfg-soon">Admin</span>
          </a>
          <a href="/admin/configuracion" class="cfg-module-link">
            <span>Organismos</span>
            <span class="cfg-soon">Admin</span>
          </a>
          <span class="cfg-module-link disabled">
            <span>Versionado de datasets</span>
            <span class="cfg-soon">Pronto</span>
          </span>
        </div>
      </aside>

      <main class="cfg-main">
        <div id="cfgNotice" class="cfg-notice" hidden></div>

        <section id="cfgEmpty" class="cfg-empty">
          <div class="cfg-empty-icon">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9"></path>
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"></path>
            </svg>
          </div>
          <h2>Selecciona una capa para configurarla</h2>
          <p>
            Ajusta colores, opacidad y rango de zoom, define los campos del popup con sus
            nombres visibles y revisa los metadatos de la capa antes de publicar.
          </p>
        </section>

        <section id="cfgEditor" class="cfg-editor" hidden>
          <header class="cfg-head">
            <div class="cfg-head-main">
              <span class="cfg-eyebrow">Configuración de capa</span>
              <h1 id="cfgLayerTitle">—</h1>
              <code id="cfgLayerId" class="cfg-layer-id">—</code>
              <div class="cfg-badges">
                <span class="cfg-badge" id="cfgWorkspaceBadge">—</span>
                <span class="cfg-badge" id="cfgTypeBadge">—</span>
                <span class="cfg-badge status" id="cfgStatusBadge">Sin configurar</span>
              </div>
            </div>
            <div class="cfg-head-actions">
              <span class="cfg-dirty" id="cfgDirty" hidden>Cambios sin guardar</span>
              <button type="button" class="cfg-btn ghost" id="cfgResetBtn" disabled>Restablecer</button>
              <button type="button" class="cfg-btn primary" id="cfgSaveBtn" disabled>Guardar cambios</button>
              <span class="cfg-save-state" id="cfgSaveState"></span>
            </div>
          </header>

          <section class="cfg-stats">
            <div class="cfg-stat">
              <span class="cfg-stat-label">Campos</span>
              <b class="cfg-stat-value" id="statCampos">0</b>
              <span class="cfg-stat-hint">detectados en la capa</span>
            </div>
            <div class="cfg-stat">
              <span class="cfg-stat-label">Visibles en popup</span>
              <b class="cfg-stat-value" id="statVisibles">0</b>
              <span class="cfg-stat-hint">atributos configurados</span>
            </div>
            <div class="cfg-stat">
              <span class="cfg-stat-label">Estado</span>
              <b class="cfg-stat-value" id="statEstado">Por defecto</b>
              <span class="cfg-stat-hint">de la simbología</span>
            </div>
            <div class="cfg-stat wide">
              <span class="cfg-stat-label">Última actualización</span>
              <b class="cfg-stat-value small" id="cfgUpdatedBy">—</b>
              <span class="cfg-stat-hint">responsable del último cambio</span>
            </div>
          </section>

          <nav class="cfg-tabs" role="tablist" aria-label="Secciones de configuración">
            <button type="button" class="cfg-tab active" role="tab" aria-selected="true" data-tab="simbologia">Simbología</button>
            <button type="button" class="cfg-tab" role="tab" aria-selected="false" data-tab="popup">Popup</button>
            <button type="button" class="cfg-tab" role="tab" aria-selected="false" data-tab="metadatos">Metadatos</button>
          </nav>

          <div class="cfg-body">
            <div class="cfg-panels">
              <section class="cfg-panel" data-panel="simbologia" role="tabpanel">
                <div id="cfgRasterNotice" class="cfg-notice inline" hidden>
                  Esta capa es un raster (WMS). La simbología vectorial y el popup de atributos
                  no aplican; se muestra únicamente la ficha de metadatos.
                </div>

                <div id="cfgFormFields" class="cfg-form">
                  <div class="cfg-section">
                    <h2 class="cfg-section-title">Color</h2>
                    <p class="cfg-section-desc">Relleno y borde de la geometría en el visor.</p>
                    <div class="cfg-grid-2">
                      <label class="cfg-field">
                        <span>Color de relleno</span>
                        <div class="cfg-color">
                          <input type="color" id="cfgFill" value="#2d5296" aria-label="Color de relleno" />
                          <input type="text" id="cfgFillHex" value="#2d5296" maxlength="7" spellcheck="false" aria-label="Hex de relleno" />
                        </div>
                      </label>
                      <label class="cfg-field">
                        <span>Color de borde</span>
                        <div class="cfg-color">
                          <input type="color" id="cfgStroke" value="#122b5a" aria-label="Color de borde" />
                          <input type="text" id="cfgStrokeHex" value="#122b5a" maxlength="7" spellcheck="false" aria-label="Hex de borde" />
                        </div>
                      </label>
                    </div>
                  </div>

                  <div class="cfg-section">
                    <h2 class="cfg-section-title">Geometría</h2>
                    <p class="cfg-section-desc">Opacidad y grosor de línea del elemento.</p>
                    <label class="cfg-field">
                      <span class="cfg-field-head">Opacidad <b id="cfgOpacityOut">0.50</b></span>
                      <input type="range" id="cfgOpacity" min="0" max="1" step="0.05" value="0.5" />
                    </label>
                    <label class="cfg-field">
                      <span class="cfg-field-head">Grosor de línea <b id="cfgLineWidthOut">1 px</b></span>
                      <input type="range" id="cfgLineWidth" min="0" max="10" step="0.5" value="1" />
                    </label>
                  </div>

                  <div class="cfg-section">
                    <h2 class="cfg-section-title">Visibilidad por zoom</h2>
                    <p class="cfg-section-desc">Rango en el que la capa permanece visible.</p>
                    <div class="cfg-grid-2">
                      <label class="cfg-field">
                        <span>Zoom mínimo</span>
                        <input type="number" id="cfgMinZoom" min="0" max="24" step="1" value="0" />
                      </label>
                      <label class="cfg-field">
                        <span>Zoom máximo</span>
                        <input type="number" id="cfgMaxZoom" min="0" max="24" step="1" value="24" />
                      </label>
                    </div>
                  </div>
                </div>
              </section>

              <section class="cfg-panel" data-panel="popup" role="tabpanel" hidden>
                <div class="cfg-section">
                  <h2 class="cfg-section-title">Campos del popup</h2>
                  <p class="cfg-section-desc">
                    Marca los atributos que se muestran al hacer clic en un elemento y, si lo
                    necesitas, asígnales un nombre visible para el usuario final.
                  </p>

                  <div class="cfg-popup-toolbar">
                    <div class="cfg-search compact">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                        <circle cx="11" cy="11" r="7"></circle>
                        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                      </svg>
                      <input type="search" id="cfgFieldSearch" placeholder="Buscar campo…" autocomplete="off" />
                    </div>
                    <div class="cfg-toolbar-actions">
                      <span id="cfgVisibleCount" class="cfg-count">0 de 0</span>
                      <button type="button" class="cfg-text-btn" id="cfgAllFields">Todos</button>
                      <button type="button" class="cfg-text-btn" id="cfgNoFields">Ninguno</button>
                    </div>
                  </div>

                  <div id="cfgFields" class="cfg-fields">
                    <p class="cfg-empty-mini">Cargando atributos…</p>
                  </div>
                </div>

                <div class="cfg-section">
                  <h2 class="cfg-section-title">Etiquetas en el mapa</h2>
                  <p class="cfg-section-desc">Muestra un atributo de cada elemento como etiqueta sobre el mapa.</p>

                  <div class="cfg-labels-card">
                    <label class="cfg-labels-toggle">
                      <span class="cfg-labels-toggle-text">
                        <span class="cfg-labels-toggle-title">Mostrar etiquetas</span>
                        <span class="cfg-labels-toggle-hint">Etiqueta cada elemento con el valor de un atributo</span>
                      </span>
                      <span class="switch">
                        <input type="checkbox" id="cfgShowLabels" />
                        <span class="switch-track"></span>
                      </span>
                    </label>

                    <div id="cfgLabelControls" class="cfg-labels-controls" hidden>
                      <div class="cfg-grid-2">
                        <div class="cfg-field">
                          <span>Atributo de la etiqueta</span>
                          <div class="cfg-select" id="cfgLabelSelect">
                            <button type="button" class="cfg-select-btn" id="cfgLabelSelectBtn" aria-haspopup="listbox" aria-expanded="false">
                              <span class="cfg-select-label" id="cfgLabelSelectLabel">Seleccionar atributo…</span>
                              <svg class="cfg-select-caret" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
                            </button>
                            <div class="cfg-select-menu" id="cfgLabelSelectMenu" role="listbox"></div>
                          </div>
                        </div>
                        <label class="cfg-field">
                          <span>Color del texto</span>
                          <div class="cfg-color">
                            <input type="color" id="cfgLabelColor" value="#3b1650" aria-label="Color de texto de la etiqueta" />
                            <input type="text" id="cfgLabelColorHex" value="#3b1650" maxlength="7" spellcheck="false" aria-label="Hex de texto de la etiqueta" />
                          </div>
                        </label>
                      </div>
                    </div>
                  </div>
                </div>
              </section>

              <section class="cfg-panel" data-panel="metadatos" role="tabpanel" hidden>
                <div class="cfg-section">
                  <h2 class="cfg-section-title">Ficha de metadatos</h2>
                  <p class="cfg-section-desc">Información declarada en el catálogo de datos.</p>
                  <div id="cfgMetadata">
                    <p class="cfg-empty-mini">Cargando metadatos…</p>
                  </div>
                </div>
              </section>
            </div>

            <aside class="cfg-preview" aria-label="Vista previa">
              <div class="cfg-preview-card">
                <div class="cfg-preview-head">
                  <span class="cfg-eyebrow">Vista previa en el mapa</span>
                  <span class="cfg-preview-tag">Tiempo real</span>
                </div>
                <div class="cfg-preview-map-wrap">
                  <div class="cfg-preview-map" id="cfgPreviewMap"></div>
                  <div class="cfg-preview-map-state" id="cfgPreviewState">Cargando vista previa…</div>
                </div>
                <div class="cfg-preview-popup" id="cfgPreviewPopup"></div>
                <p class="cfg-preview-hint">
                  La capa se dibuja en el mapa con la simbología actual. Al guardar, el cambio
                  se aplica para todas las sesiones del Geoportal.
                </p>
              </div>
            </aside>
          </div>
        </section>
      </main>
    </div>
  </div>

  <script is:inline>
    window.cerrarSesion = () => {
      localStorage.removeItem('auth_session');
      localStorage.removeItem('auth_token');
      window.location.href = '/login';
    };
  </script>

  <script>
    import '../scripts/config-main.js';
  </script>
</GeoportalLayout>
