---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/manager-licencias.css';
---

<AdminLayout title="Licencias · Admin BSD">
  <header class="admin-header">
    <div>
      <span class="admin-eyebrow">Panel gerencial</span>
      <h1>Licencias · tabla de atributos</h1>
      <p>Registros de la capa de licencias configurada, con filtros y ficha por registro.</p>
    </div>
    <a class="manager-table-link" href="/admin">← Volver al dashboard</a>
  </header>

  <section class="cat-controls" aria-label="Filtros de licencias">
    <div class="cat-zone-row">
      <label for="lic-filter-empresa">Empresa</label>
      <select id="lic-filter-empresa"><option value="">Todas</option></select>
      <label for="lic-filter-tipo">Tipo</label>
      <select id="lic-filter-tipo"><option value="">Todos</option></select>
      <label for="lic-filter-estatus">Estatus</label>
      <select id="lic-filter-estatus"><option value="">Todos</option></select>
      <label for="lic-filter-anio">Año</label>
      <select id="lic-filter-anio"><option value="">Todos</option></select>
      <input id="lic-page-search" type="search" placeholder="Buscar código, empresa, bloque…" autocomplete="off" />
      <button type="button" class="cat-ghost" id="lic-clear">Limpiar</button>
    </div>
    <div class="cat-zone-row cat-zone-row-secondary">
      <p class="admin-status" id="lic-page-status" aria-live="polite">Cargando licencias…</p>
    </div>
  </section>

  <div class="admin-table-wrap manager-table-card">
    <div class="admin-table-head">
      <div>
        <h2>Tabla de atributos</h2>
        <p id="lic-table-count">—</p>
      </div>
    </div>
    <div class="manager-table-scroll">
      <table class="admin-table manager-table" id="lic-table">
        <thead>
          <tr>
            <th data-sort="codigo" data-dir="asc">Código</th>
            <th data-sort="bloque">Licencia</th>
            <th data-sort="empresa">Empresa</th>
            <th data-sort="tipo">Tipo</th>
            <th data-sort="estatus">Estatus</th>
            <th data-sort="anio" class="year-cell">Año</th>
            <th data-sort="duracion_anios">Duración</th>
            <th data-sort="area_km2" class="area-cell">Área (km²)</th>
          </tr>
        </thead>
        <tbody id="lic-table-body">
          <tr><td colspan="8" class="manager-empty">Cargando licencias…</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Ficha de atributos del registro -->
  <div class="lic-layer-modal" id="lic-attr-modal" hidden>
    <div class="lic-layer-card" role="dialog" aria-modal="true" aria-labelledby="lic-attr-title">
      <header>
        <div>
          <h3 id="lic-attr-title">Licencia</h3>
          <p class="lic-layer-hint" id="lic-attr-sub"></p>
        </div>
        <button type="button" class="lic-layer-close" id="lic-attr-close" aria-label="Cerrar">✕</button>
      </header>
      <div class="lic-attr-list" id="lic-attr-body"></div>
      <footer>
        <a class="lic-layer-cancel" id="lic-attr-map" href="/admin/#licencias">Ver en el mapa</a>
      </footer>
    </div>
  </div>

  <Footer slot="footer" />
</AdminLayout>

<script>
  import '../../scripts/admin-licencias.js';
</script>
