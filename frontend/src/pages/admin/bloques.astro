---
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="Bloques · Admin BSD">
  <header class="admin-header">
    <div>
      <span class="admin-eyebrow">Sección</span>
      <h1>Bloques petroleros</h1>
      <p>Inventario real de bloques publicados en el catálogo.</p>
    </div>
  </header>

  <div class="admin-table-wrap">
    <div class="admin-table-head">
      <h2>Listado de bloques</h2>
      <span class="admin-status" id="bloques-count" aria-live="polite">Cargando…</span>
      <input
        type="search"
        class="admin-search"
        placeholder="Buscar bloque o ID…"
        oninput="filtrarTabla(this.value)"
      />
    </div>
    <table class="admin-table" id="tabla-bloques">
      <thead>
        <tr>
          <th>Bloque</th>
          <th>ID</th>
          <th>Área</th>
          <th>Centroide (lat, lng)</th>
        </tr>
      </thead>
      <tbody id="tabla-bloques-body">
        <tr><td colspan="4" class="admin-table-empty">Cargando bloques…</td></tr>
      </tbody>
    </table>
  </div>

  <script is:inline>
    window.filtrarTabla = (q) => {
      const term = (q || '').toLowerCase();
      document.querySelectorAll('#tabla-bloques tbody tr').forEach((tr) => {
        tr.style.display = tr.innerText.toLowerCase().includes(term) ? '' : 'none';
      });
    };
  </script>
</AdminLayout>

<script>
  import '../../scripts/admin-bloques.js';
</script>
