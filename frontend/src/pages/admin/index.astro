---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AccessGrid from '../../components/admin/AccessGrid.astro';
import ManagerLicencias from '../../components/admin/ManagerLicencias.astro';
import Footer from '../../components/Footer.astro';
---

<AdminLayout
  title="Dashboard · Admin BSD"
  subtitle="Panel de administración del geoportal"
>

  <div class="admin-dashboard">

    <header class="admin-header">
      <div>
        <span
          class="admin-eyebrow"
          data-label-admin="Panel de administración"
          data-label-gerente="Resumen ejecutivo"
        >Panel de administración</span>
        <h1 data-label-admin="Dashboard" data-label-gerente="Dashboard gerencial">Dashboard</h1>
        <p data-visible-for="Administrador">Métricas reales del catálogo de capas y del geoportal.</p>
        <p data-visible-for="Rol_gerente" hidden>Resumen gerencial de licencias, empresas y superficie concesionada.</p>
      </div>
    </header>

    <AccessGrid />

    <div class="admin-dashboard-legacy" data-visible-for="Administrador">
      <p class="admin-status" id="adm-status" aria-live="polite">Cargando métricas del catálogo…</p>

      <section class="kpi-grid kpi-grid-4">
        <article class="kpi-card" style="--accent:#2d5296">
          <div class="kpi-label">Capas publicadas</div>
          <div class="kpi-value" id="adm-kpi-layers">—</div>
          <div class="kpi-hint" id="adm-kpi-layers-hint">—</div>
        </article>
        <article class="kpi-card" style="--accent:#0f766e">
          <div class="kpi-label">Registros totales</div>
          <div class="kpi-value" id="adm-kpi-features">—</div>
          <div class="kpi-hint">features en capas vectoriales</div>
        </article>
        <article class="kpi-card" style="--accent:#b45309">
          <div class="kpi-label">Capas con metadatos</div>
          <div class="kpi-value" id="adm-kpi-metadata">—</div>
          <div class="kpi-hint">fichas ISO/QGIS registradas</div>
        </article>
        <article class="kpi-card" style="--accent:#7c3aed">
          <div class="kpi-label">Sesiones activas</div>
          <div class="kpi-value" id="adm-kpi-sessions">—</div>
          <div class="kpi-hint">usuarios con sesión vigente</div>
        </article>
      </section>

      <section class="charts-row two">
        <div class="chart-card">
          <h3>Capas por tipo de geometría</h3>
          <p class="chart-sub">Distribución del catálogo publicado</p>
          <div id="adm-chart-tipos" style="height:280px"></div>
        </div>
        <div class="chart-card">
          <h3>Top capas por registros</h3>
          <p class="chart-sub">Seis capas con más features</p>
          <div id="adm-chart-top" style="height:280px"></div>
        </div>
      </section>

      <section class="charts-row">
        <div class="chart-card">
          <h3>Registros por workspace</h3>
          <p class="chart-sub">Volumen de datos por grupo del catálogo</p>
          <div id="adm-chart-ws" style="height:260px"></div>
        </div>
      </section>
    </div>

    <ManagerLicencias />
  </div>

  <Footer slot="footer" />

</AdminLayout>

<script>
  import '../../scripts/admin-dashboard.js';
</script>
