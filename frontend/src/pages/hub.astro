---
import HubLayout from '../layouts/HubLayout.astro';
import Footer from '../components/Footer.astro';

const modes = [

  {
    href: '/geoportal',
    tag: 'Operación',
    title: 'Geoportal',
    desc: 'Visualiza, filtra y consulta las capas activas. Acceso completo según tu rol y organismo asignado.',
    accent: 'teal',
    icon: `<polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline>`,
  },
  {
    href: '/showroom',
    tag: 'Demostración',
    title: 'Showroom',
    desc: 'Recorrido guiado por las capacidades del portal con datos de ejemplo. Ideal para presentaciones y capacitación.',
    accent: 'amber',
    icon: `<polygon points="6 3 20 12 6 21 6 3"></polygon>`,
  },

  {
  href: '/analista',
  tag: 'Configuración de estilos',
  title: 'Personalizar Geoportal',
  desc: 'Define colores, opacidad, grosor, escala y atributos del popup para cada capa. Los cambios se aplican globalmente al recargar el Geoportal.',
  accent: 'blue',
  icon: `<path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4 12.5-12.5z"/>`,
},
];

const accents = {
  blue: { acc: '#2d5296', rgb: '45, 82, 150' },
  teal: { acc: '#0f766e', rgb: '15, 118, 110' },
  amber: { acc: '#b45309', rgb: '180, 83, 9' },
};

const modesWithAccent = modes.map((m) => ({
  ...m,
  ...accents[m.accent as keyof typeof accents],
}));
---

<HubLayout
  title="Hub · BSD Geoportal"
  subtitle="Elige tu modo de acceso al banco soberano de datos"
>

  <section class="hub-hero">
    <div class="hub-hero-grid"></div>
    <div class="hub-hero-glow"></div>
    <div class="hub-hero-glow hub-hero-glow-2"></div>

    <div class="hub-hero-inner">
      <span class="hub-eyebrow">
        <span class="hub-eyebrow-dot"></span>
        Selección de modo
      </span>

      <h1>
        ¿Cómo quieres entrar<br />
        al <em>Geoportal</em>?
      </h1>

      <p>
        Tres modos de operación sobre el mismo banco de datos soberano:
        administración, consulta y demostración.
      </p>
    </div>
  </section>

  <div class="hub-modes">
    <div class="hub-modes-grid">
      {modesWithAccent.map((m) => (
        <a href={m.href} class="hub-card" style={`--acc:${m.acc};--acc-rgb:${m.rgb};`}>
          <span class="hub-card-bar"></span>
          <span class="hub-card-radial"></span>

          <div class="hub-card-icon">
            <svg
              xmlns="http://www.w3.org/2000/svg"
              viewBox="0 0 24 24"
              width="24"
              height="24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.8"
              stroke-linecap="round"
              stroke-linejoin="round"
              set:html={m.icon}
            />
          </div>

          <span class="hub-card-tag">{m.tag}</span>

          <h2>{m.title}</h2>

          <span class="hub-card-divider"></span>

          <p class="hub-card-desc">{m.desc}</p>

          <span class="hub-card-cta">
            Entrar
            <span class="hub-card-cta-arrow">
              <svg viewBox="0 0 24 24"
                   stroke="currentColor" stroke-width="2" fill="none"
                   stroke-linecap="round" stroke-linejoin="round">
                <line x1="5" y1="12" x2="19" y2="12" />
                <polyline points="12 5 19 12 12 19" />
              </svg>
            </span>
          </span>
        </a>
      ))}
    </div>
  </div>

  <Footer slot="footer" />

  <style>
    /* Entrada escalonada (solo /hub, no afecta al admin) */
    .hub-hero-inner > * {
      animation: hubRise .7s cubic-bezier(.2, .8, .2, 1) backwards;
    }
    .hub-hero-inner .hub-eyebrow { animation-delay: .05s; }
    .hub-hero-inner h1 { animation-delay: .15s; }
    .hub-hero-inner p { animation-delay: .28s; }

    .hub-card {
      animation: hubRise .65s cubic-bezier(.2, .8, .2, 1) backwards;
    }
    .hub-card:nth-child(1) { animation-delay: .38s; }
    .hub-card:nth-child(2) { animation-delay: .5s; }
    .hub-card:nth-child(3) { animation-delay: .62s; }

    @keyframes hubRise {
      from { opacity: 0; transform: translateY(20px); }
      to   { opacity: 1; transform: none; }
    }

    @media (prefers-reduced-motion: reduce) {
      .hub-hero-inner > *,
      .hub-card { animation: none; }
      .hub-hero-glow { animation: none; }
    }
  </style>

</HubLayout>