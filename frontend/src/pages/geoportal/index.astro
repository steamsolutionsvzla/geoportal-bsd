---
import 'maplibre-gl/dist/maplibre-gl.css';
// Fuentes (instaladas con @fontsource)
import '@fontsource/fraunces/400.css';
import '@fontsource/fraunces/500.css';
import '@fontsource/fraunces/600.css';
import '@fontsource/plus-jakarta-sans/400.css';
import '@fontsource/plus-jakarta-sans/500.css';
import '@fontsource/plus-jakarta-sans/600.css';
import '@fontsource/plus-jakarta-sans/700.css';
import '@fontsource/plus-jakarta-sans/800.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '../../styles/geoportal.css';
import '../../styles/metadata-qgis.css';
import Footer from '../../components/Footer.astro';
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Geoportal-BSD</title>
  <link rel="icon" type="image/svg+xml" href="/img/favicon.svg">
  
</head>
<body>
  <div id="global-error" style="display:none; background-color: #fef2f2; color: #991b1b; padding: 12px 16px; border-radius: 8px; margin: 10px; border: 1px solid #fecaca; font-size: 0.9rem; position: relative; z-index: 9999;">
    <strong>⚠️ Error:</strong> <span id="error-text">No se pudo conectar con el servidor.</span>
    <button onclick="document.getElementById('global-error').style.display='none'" style="float:right; background:transparent; border:none; color:#991b1b; font-weight:bold; cursor:pointer;">✕</button>
  </div>
  <script>
  import '../../scripts/session.js';   
</script>

  <script is:inline>
    // Si se abrió desde el panel de admin, la casita vuelve a /admin
    document.addEventListener('DOMContentLoaded', () => {
      if (new URLSearchParams(location.search).get('from') !== 'admin') return;
      const home = document.getElementById('homeBtn');
      if (!home) return;
      home.setAttribute('href', '/admin');
      home.setAttribute('title', 'Volver a admin');
      home.setAttribute('aria-label', 'Volver a admin');
    });
  </script>

  <script is:inline>
    const sesionActiva = localStorage.getItem('auth_token');
    if (!sesionActiva) {
      window.location.href = '/login';
    }
    window.cerrarSesion = () => {
      localStorage.removeItem('auth_session');
      localStorage.removeItem('auth_token'); 
      window.location.href = '/login';
    };
  </script>

  <div class="app">
    <!-- TOPBAR -->
    <header class="topbar">
      <div class="brand">
        <img src="/img/logo.png" alt="Banco Soberano de Datos de Petróleo y Gas" class="brand-logo">
      </div>
      <div class="brand-text">
        <span class="name">Geoportal</span>
      </div>
      <div class="topbar-actions">
        <a href="/hub" class="icon-btn" id="homeBtn" title="Volver al hub" aria-label="Volver al hub">
          <svg viewBox="0 0 24 24" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 12l9-9 9 9"/>
            <path d="M5 10v10h14V10"/>
          </svg>
        </a>
        <button class="icon-btn logout-btn" title="Cerrar sesión" aria-label="Cerrar sesión" onclick="cerrarSesion()">
          <svg viewBox="0 0 24 24" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
            <polyline points="16 17 21 12 16 7"></polyline>
            <line x1="21" y1="12" x2="9" y2="12"></line>
          </svg>
        </button>
        <div class="user-chip" title="Sesión iniciada">
          <div class="user-info">
            <span class="u-name">Juan Fernández</span>
            <span class="u-role">Dpto. de Datos Digitales</span>
          </div>
          <div class="avatar">JF</div>
        </div>
      </div>
    </header>

    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar">
      <div class="filter-panel">
        <div class="panel-heading">
          <span class="eyebrow">Filtrar por ubicación</span>
        </div>
        <div class="filter-group">
          <div class="loc-filter" id="filterEstado">
            <button type="button" class="loc-filter-btn" data-placeholder="Estado">
              <svg class="lf-icon" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-7.2-7-12a7 7 0 0 1 14 0c0 4.8-7 12-7 12z"/><circle cx="12" cy="9" r="2.5"/></svg>
              <span class="lf-label">Estado</span>
              <svg class="lf-caret" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="loc-filter-dropdown" id="dropdownEstado">
              <div class="loc-option selected" data-value="">Todos los estados</div>
            </div>
          </div>
          <div class="loc-filter" id="filterBloque">
            <button type="button" class="loc-filter-btn" data-placeholder="Bloque">
              <svg class="lf-icon" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s-7-7.2-7-12a7 7 0 0 1 14 0c0 4.8-7 12-7 12z"/><circle cx="12" cy="9" r="2.5"/></svg>
              <span class="lf-label">Bloque</span>
              <svg class="lf-caret" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="loc-filter-dropdown" id="dropdownBloque">
              <div class="loc-option selected" data-value="">Todos los bloques</div>
            </div>
          </div>
          <div class="loc-filter area-filter" id="filterArea" hidden>
            <button type="button" class="loc-filter-btn" data-placeholder="Área de análisis" id="filterAreaBtn">
              <svg class="lf-icon" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><path d="M4 15l4-9 8 2 4 7-6 5z"/><circle cx="8" cy="6" r="1"/><circle cx="16" cy="8" r="1"/><circle cx="20" cy="15" r="1"/><circle cx="14" cy="20" r="1"/><circle cx="4" cy="15" r="1"/></svg>
              <span class="lf-label">Área de análisis</span>
              <svg class="lf-caret" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"></polyline></svg>
            </button>
            <div class="loc-filter-dropdown area-dropdown" id="dropdownArea">
              <input type="file" id="areaFileInput" accept=".geojson,.json,.zip" hidden>
              <div class="area-action-row">
                <button type="button" class="area-upload-btn" id="areaUploadBtn">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 16V4"></path><polyline points="7 9 12 4 17 9"></polyline><path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3"></path>
                  </svg>
                  Cargar SHP / GeoJSON…
                </button>
                <button type="button" class="area-draw-btn" id="areaDrawBtn">
                  <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 15l4-9 8 2 4 7-6 5z"/><circle cx="8" cy="6" r="1"/><circle cx="16" cy="8" r="1"/><circle cx="20" cy="15" r="1"/><circle cx="14" cy="20" r="1"/><circle cx="4" cy="15" r="1"/>
                  </svg>
                  Dibujar polígono
                </button>
              </div>
              <div class="area-file-row" id="areaFileRow" hidden>
                <span class="area-file-name" id="areaFileName"></span>
                <button type="button" class="area-clear-btn" id="areaClearLayerBtn" title="Quitar capa del área" aria-label="Quitar capa del área">✕</button>
              </div>
              <label class="area-label-field" id="areaLabelField" hidden>
                <span>Etiqueta de entidad</span>
                <select id="areaLabelSelect"></select>
              </label>
              <div class="area-entity-list" id="areaEntityList"></div>
              <p class="area-hint" id="areaHint">Carga un Shapefile (.zip) o GeoJSON, o dibuja un polígono.</p>
              <p class="area-error" id="areaError" hidden></p>
            </div>
          </div>
        </div>
      </div>
      <div class="panel-heading">
        <span class="eyebrow">Capas del mapa</span>
        <span class="count" id="layerCount">0 activas</span>
      </div>
      <div class="layer-search">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="11" cy="11" r="7"></circle>
          <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
        </svg>
        <input
          type="search"
          id="layerSearch"
          placeholder="Buscar capa…"
          autocomplete="off"
          aria-label="Buscar capa"
        />
        <button type="button" class="layer-search-clear" id="layerSearchClear" title="Limpiar búsqueda" aria-label="Limpiar búsqueda" hidden>✕</button>
      </div>
      <div class="layer-search-count" id="layerSearchCount" hidden></div>
      <div class="layers-scroll-area">
        <div id="layersGroupsContainer"></div>
      </div>
    </aside>

    <!-- MAP -->
    <div class="map-wrap">
      <div id="map"></div>
      <div class="compass" title="Norte">
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <circle cx="50" cy="50" r="46" fill="rgba(255,255,255,0.95)" stroke="rgba(45,82,150,0.35)" stroke-width="1.5"/>
          <circle cx="50" cy="50" r="37" fill="none" stroke="rgba(45,82,150,0.25)" stroke-width="1"/>
          <g stroke="rgba(45,82,150,0.5)" stroke-width="1.5">
            <line x1="50" y1="6" x2="50" y2="13"/>
            <line x1="50" y1="87" x2="50" y2="94"/>
            <line x1="6" y1="50" x2="13" y2="50"/>
            <line x1="87" y1="50" x2="94" y2="50"/>
          </g>
          <polygon points="50,15 44.5,50 50,50" fill="#c1584a"/>
          <polygon points="50,15 55.5,50 50,50" fill="rgba(193,88,74,0.55)"/>
          <polygon points="50,85 44.5,50 50,50" fill="#122b5a"/>
          <polygon points="50,85 55.5,50 50,50" fill="rgba(18,43,90,0.5)"/>
          <circle cx="50" cy="50" r="3.5" fill="#ffffff" stroke="#122b5a" stroke-width="1"/>
          <text x="50" y="23" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="9" font-weight="600" fill="#122b5a">N</text>
          <text x="50" y="83" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#64748b">S</text>
          <text x="19" y="53" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#64748b">O</text>
          <text x="81" y="53" text-anchor="middle" font-family="'JetBrains Mono', monospace" font-size="7.5" fill="#64748b">E</text>
        </svg>
      </div>

      <button type="button" class="panel-toggle-btn toggle-left" id="sidebarToggleBtn" aria-label="Alternar capas">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>
      <button type="button" class="panel-toggle-btn toggle-right" id="infoToggleBtn" aria-label="Alternar información">
        <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>

      <div class="graticule">
        <div class="grat-edge top" id="gratTop"></div>
        <div class="grat-edge bottom" id="gratBottom"></div>
        <div class="grat-edge left" id="gratLeft"></div>
        <div class="grat-edge right" id="gratRight"></div>
      </div>

      <div class="basemap-switch">
        <button type="button" class="basemap-btn" id="basemapToggleBtn" title="Cambiar mapa base">
          <svg viewBox="0 0 24 24" width="20" height="20" stroke="currentColor" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="1 6 1 22 8 18 16 22 23 18 23 2 16 6 8 2 1 6"></polygon>
            <line x1="8" y1="2" x2="8" y2="18"></line>
            <line x1="16" y1="6" x2="16" y2="22"></line>
          </svg>
        </button>
        <div class="basemap-dropdown" id="basemapDropdown">
          <div class="basemap-title">Mapa Base</div>
          <div class="basemap-option active" data-basemap="clara">
            <div class="basemap-preview bm-light"></div>
            <div class="basemap-info">
              <span class="bm-name">Estándar</span>
              <span class="bm-desc">Base física clara</span>
            </div>
          </div>
          <div class="basemap-option" data-basemap="satelite">
            <div class="basemap-preview bm-sat"></div>
            <div class="basemap-info">
              <span class="bm-name">Satélite</span>
              <span class="bm-desc">Imágenes Esri + Híbrido</span>
            </div>
          </div>
        </div>
      </div>

      <div class="legend-switch">
        <div class="legend-popover" id="legendPopover">
          <div class="legend-popover-header">
            <span>Leyenda</span>
            <button type="button" class="close-popover-btn" id="closeLegendBtn">&times;</button>
          </div>
          <div class="legend-list" id="legendList"></div>
        </div>
        <button type="button" class="legend-toggle-btn" id="legendToggleBtn" title="Ver Leyenda">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polygon points="6 3 3 8.5 6 7 9 8.5 6 3" />
            <rect x="3" y="10.5" width="6" height="5.5" rx="1" fill="currentColor" />
            <circle cx="6" cy="19.5" r="2.8" fill="none" />
            <line x1="12" y1="5.5" x2="21" y2="5.5" />
            <line x1="12" y1="13.2" x2="21" y2="13.2" />
            <line x1="12" y1="19.5" x2="21" y2="19.5" />
          </svg>
          <span class="legend-toggle-label">Leyenda</span>
        </button>
      </div>

      <div class="map-tools" id="mapTools">
        <button type="button" class="map-tool-btn" id="measureDistanceBtn" title="Medir distancia" aria-label="Medir distancia">
          <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 17l14-14 4 4L7 21H3z"/><path d="M7 13l2 2"/><path d="M10 10l2 2"/><path d="M13 7l2 2"/>
          </svg>
        </button>
        <button type="button" class="map-tool-btn map-tool-subtle" id="mapToolUndoBtn" title="Deshacer último punto" aria-label="Deshacer último punto" hidden>
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="9 14 4 9 9 4"></polyline><path d="M4 9h10a6 6 0 0 1 0 12h-3"></path>
          </svg>
        </button>
        <button type="button" class="map-tool-btn map-tool-subtle" id="mapToolCancelBtn" title="Cancelar herramienta" aria-label="Cancelar herramienta" hidden>✕</button>
      </div>

      <div class="map-tool-hint" id="mapToolHint" hidden></div>

      <div class="measure-chip" id="measureChip" hidden>
        <span class="measure-chip-label">Distancia total</span>
        <b id="measureTotal">0 m</b>
        <button type="button" id="measureClearBtn" title="Limpiar medición" aria-label="Limpiar medición">✕</button>
      </div>

      <div class="zoom-controls">
        <button class="zoom-btn" id="zoomIn">+</button>
        <button class="zoom-btn" id="zoomOut">–</button>
      </div>
    </div>

    <aside class="info-panel" id="infoPanel">
      <div class="panel-heading">
        <span class="eyebrow">Información</span>
      </div>
      <div class="info-panel-content" id="infoPanelContent">
        <div class="info-card">
          <div class="ic-label">Detalles del elemento</div>
          <p class="info-card-empty">Selecciona una entidad del mapa para desplegar su información técnica y atributos aquí.</p>
        </div>
      </div>
    </aside>

    <footer class="statusbar">
      <div class="stat">LAT/LON <b id="statCoord">0.00000° N 0.00000° W</b></div>
      <div class="divider"></div>
      <div class="stat">Escala <b id="statScale">-- km</b></div>
      <div class="divider"></div>
      <div class="stat">ZOOM <b id="statZoom">6.8</b></div>
      <div class="divider"></div>
      <div class="stat">DATUM <b>REGVEN (EPSG:4189)</b></div>
      <div class="grow"></div>
      <div class="stat">GEOPORTAL v0.1</div>
    </footer>
  </div>

  <!-- Footer compartido (el mismo del index) -->
  <Footer />

  <script>
    import '../../scripts/main.js';
  </script>
</body>
</html>