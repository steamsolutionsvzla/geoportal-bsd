---
import '../styles/nav.css';
---
<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="brand-block">
      <img src="/img/logo.png" alt="BSD" class="brand-mark-img" />
      <span class="brand-name">Geoportal</span>
    </a>

    <div class="nav-links">
      <a href="#plataforma" data-link>Plataforma</a>
      <a href="#funciones" data-link>Funciones</a>
      <a href="#cobertura" data-link>Cobertura</a>
    </div>

    <div class="nav-cta">
      <button class="menu-toggle" aria-label="Menú">
        <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
      <a href="/login" class="btn btn-primary">
        Iniciar sesión
        <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14" /><path d="M13 6l6 6-6 6" />
        </svg>
      </a>
    </div>
  </div>
</nav>

<script>
  const nav = document.querySelector('.nav');
  const onScroll = () => {
    if (!nav) return;
    nav.classList.toggle('is-scrolled', window.scrollY > 8);
  };
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
</script>