---
// Accesos rápidos compactos al final del dashboard.
// Se mantiene la visibilidad por rol: Capas publicadas solo Gerente.
const items = [
  {
    href: '/admin/paquetes',
    label: 'Paquetes',
    external: false,
    visibleFor: null,
    icon: `<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line>`,
  },
  {
    href: '/admin/catalogo',
    label: 'Capas publicadas',
    external: false,
    visibleFor: 'Rol_gerente',
    icon: `<ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"></path><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"></path>`,
  },
  {
    href: '/geoportal?from=admin',
    label: 'Geoportal',
    external: true,
    visibleFor: null,
    icon: `<polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline>`,
  },
];
---

<nav class="admin-shortcuts" aria-label="Accesos rápidos del dashboard">
  {items.map((it) => (
    <a
      href={it.href}
      class="admin-shortcut"
      target={it.external ? '_blank' : undefined}
      rel={it.external ? 'noopener noreferrer' : undefined}
      data-visible-for={it.visibleFor || undefined}
      hidden={it.visibleFor ? true : undefined}
    >
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.9"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        set:html={it.icon}
      />
      <span>{it.label}</span>
    </a>
  ))}
</nav>
