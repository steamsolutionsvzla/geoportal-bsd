---
const items = [
  {
    href: '/admin/bloques',
    title: 'Bloques',
    desc: 'Inventario, ventas y estado de bloques petroleros.',
    accent: '#2d5296',
    external: false,
    icon: `<polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline>`,
  },
  {
    href: '/admin/paquetes',
    title: 'Paquetes',
    desc: 'Entrega y construcción de paquetes de capas.',
    accent: '#0f766e',
    external: false,
    icon: `<path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line>`,
  },
  {
    href: '/admin/configuracion',
    title: 'Configuración',
    desc: 'Usuarios, roles y organismos del sistema.',
    accent: '#b45309',
    external: false,
    icon: `<circle cx="12" cy="12" r="3"></circle><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.6 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.6a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"></path>`,
  },
  {
    href: '/geoportal?from=admin',
    title: 'Geoportal',
    desc: 'Abrir el geoportal operativo en una pestaña nueva.',
    accent: '#7c3aed',
    external: true,
    icon: `<polygon points="12 2 2 7 12 12 22 7 12 2"></polygon><polyline points="2 17 12 22 22 17"></polyline><polyline points="2 12 12 17 22 12"></polyline>`,
  },
];
---

<div class="access-grid">
  {items.map((it) => (
    <a
      href={it.href}
      class="access-card"
      style={`--accent:${it.accent}`}
      target={it.external ? '_blank' : undefined}
      rel={it.external ? 'noopener noreferrer' : undefined}
    >
      <div class="access-icon">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.8"
          stroke-linecap="round"
          stroke-linejoin="round"
          set:html={it.icon}
        />
      </div>
      <h3 class="access-title">{it.title}</h3>
      <p class="access-desc">{it.desc}</p>
    </a>
  ))}
</div>
<style>
  .access-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 24px 0 32px;
  }

  @media (max-width: 1100px) {
    .access-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .access-grid {
      grid-template-columns: 1fr;
    }
  }

  .access-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 20px;
    background: #fff;
    border: 1px solid var(--line-200, #e5e7eb);
    border-radius: 14px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }

  .access-card:hover {
    border-color: var(--accent);
    transform: translateY(-1px);
    box-shadow: 0 6px 18px rgba(15, 23, 42, 0.06);
  }

  .access-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: color-mix(in srgb, var(--accent) 12%, #fff);
    color: var(--accent);
  }

  .access-icon svg {
    width: 20px;
    height: 20px;
  }

  .access-title {
    margin: 0;
    font-family: 'Fraunces', serif;
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--navy-900, #0b1b3a);
  }

  .access-desc {
    margin: 0;
    font-size: 0.85rem;
    line-height: 1.5;
    color: var(--ink-500, #4b5563);
  }
</style>