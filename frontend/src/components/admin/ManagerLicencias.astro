---
import 'maplibre-gl/dist/maplibre-gl.css';
import '../../styles/manager-licencias.css';
---

<section
  id="licencias"
  class="manager-licencias"
  data-visible-for="Rol_gerente"
  hidden
  aria-labelledby="licencias-title"
>
  <header class="manager-section-head">
    <div>
      <span class="manager-eyebrow">Panel gerencial</span>
      <h2 id="licencias-title">Licencias</h2>
      <p>Licencias, empresas, vigencia y superficie concesionada.</p>
    </div>
    <div class="manager-head-actions">
      <button
        type="button"
        class="manager-table-link"
        id="lic-table-toggle"
        aria-expanded="false"
        aria-controls="lic-table-panel"
      >Ver tabla de licencias</button>
      <button
        type="button"
        class="manager-layers-btn"
        id="lic-layer-btn"
        title="Cambiar la capa que alimenta este panel"
      >⚙ Capa</button>
      <span class="manager-status" id="licencias-status" aria-live="polite">Cargando datos…</span>
    </div>
  </header>

  <div class="licencias-filters" aria-label="Filtros de licencias">
    <div class="licencias-filter">
      <label for="lic-filter-empresa">Empresa</label>
      <select id="lic-filter-empresa">
        <option value="">Todas</option>
      </select>
    </div>
    <div class="licencias-filter">
      <label for="lic-filter-tipo">Tipo</label>
      <select id="lic-filter-tipo">
        <option value="">Todos</option>
      </select>
    </div>
    <div class="licencias-filter">
      <label for="lic-filter-estatus">Estatus</label>
      <select id="lic-filter-estatus">
        <option value="">Todos</option>
      </select>
    </div>
    <div class="licencias-filter">
      <label for="lic-filter-anio">Año</label>
      <select id="lic-filter-anio">
        <option value="">Todos</option>
      </select>
    </div>
    <button type="button" class="licencias-clear" id="lic-clear">Limpiar</button>
  </div>

  <section class="kpi-grid manager-kpis" aria-label="Indicadores de licencias">
    <article class="kpi-card" style="--accent:#2d5296">
      <div class="kpi-label">Total de licencias</div>
      <div class="kpi-value" id="lic-kpi-total">—</div>
      <div class="kpi-hint">licencias registradas</div>
    </article>
    <article class="kpi-card" style="--accent:#15803d">
      <div class="kpi-label">Licencias vigentes</div>
      <div class="kpi-value" id="lic-kpi-vigentes">—</div>
      <div class="kpi-hint">estatus VIGENTE</div>
    </article>
    <article class="kpi-card" style="--accent:#dc2626">
      <div class="kpi-label">Licencias culminadas</div>
      <div class="kpi-value" id="lic-kpi-culminadas">—</div>
      <div class="kpi-hint">estatus CULMINADA</div>
    </article>
    <article class="kpi-card" style="--accent:#7c3aed">
      <div class="kpi-label">Área total</div>
      <div class="kpi-value" id="lic-kpi-area">—</div>
      <div class="kpi-hint">km² concesionados</div>
    </article>
  </section>

  <div class="manager-viz">
    <article class="manager-chart-card manager-viz-area-tipo">
      <h3>Tipo de licencia</h3>
      <p class="chart-sub">GAS y CRUDO por estatus</p>
      <div class="manager-chart-box" id="lic-chart-tipo" role="img" aria-label="Distribución por tipo de licencia y estatus"></div>
    </article>

    <article class="manager-map-card">
      <div id="manager-map" class="manager-map"></div>
      <div class="manager-map-zoom" aria-label="Controles de zoom">
        <button type="button" id="manager-zoom-in" title="Acercar" aria-label="Acercar">+</button>
        <button type="button" id="manager-zoom-out" title="Alejar" aria-label="Alejar">−</button>
      </div>
      <button
        type="button"
        class="manager-map-reset"
        id="manager-map-reset"
        title="Volver a la vista completa de Venezuela"
        aria-label="Volver a la vista completa de Venezuela"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M3 10.5 12 3l9 7.5"></path>
          <path d="M5 9.5V21h14V9.5"></path>
          <path d="M9 21v-6h6v6"></path>
        </svg>
        <span>Vista Venezuela</span>
      </button>
      <div class="manager-map-legend" aria-label="Leyenda del mapa">
        <span><i class="legend-dot vigente"></i> Licencia vigente</span>
        <span><i class="legend-dot culminada"></i> Licencia culminada</span>
        <span><i class="legend-dot borde"></i> Límite estadal</span>
      </div>
      <div class="manager-map-loading" id="manager-map-loading">
        <span class="manager-spinner"></span>
        <span>Cargando mapa…</span>
      </div>
      <div class="manager-map-error" id="manager-map-error" hidden></div>
    </article>

    <article class="manager-chart-card manager-viz-area-empresa">
      <h3>Licencias por empresa</h3>
      <p class="chart-sub">Vigentes y culminadas</p>
      <div class="manager-chart-box" id="lic-chart-empresa" role="img" aria-label="Licencias por empresa y estatus"></div>
    </article>

    <article class="manager-chart-card manager-viz-area-estatus">
      <h3>Estatus de licencias</h3>
      <p class="chart-sub">Vigencia de las licencias</p>
      <div class="manager-chart-box" id="lic-chart-estatus" role="img" aria-label="Distribución por estatus"></div>
    </article>

    <article class="manager-chart-card manager-viz-area-anio">
      <h3>Licencias por año</h3>
      <p class="chart-sub">Vigentes y culminadas por año</p>
      <div class="manager-chart-box" id="lic-chart-anio" role="img" aria-label="Licencias por año y estatus"></div>
    </article>
  </div>

  <section class="manager-table-panel" id="lic-table-panel" hidden>
    <div class="admin-table-wrap manager-table-card">
      <div class="admin-table-head">
        <div>
          <h2>Tabla de licencias</h2>
          <p id="lic-table-count">—</p>
        </div>
      </div>
      <div class="manager-table-scroll">
        <table class="admin-table manager-table" id="lic-table">
          <thead>
            <tr>
              <th data-sort="codigo" data-dir="asc">Código</th>
              <th data-sort="bloque">Licencia</th>
              <th data-sort="empresa">Empresa</th>
              <th data-sort="tipo">Tipo</th>
              <th data-sort="estatus">Estatus</th>
              <th data-sort="anio" class="year-cell">Año</th>
              <th data-sort="duracion_anios">Duración</th>
              <th data-sort="area_km2" class="area-cell">Área (km²)</th>
            </tr>
          </thead>
          <tbody id="lic-table-body">
            <tr><td colspan="8" class="manager-empty">Cargando licencias…</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>
</section>

<!-- Selector de la capa que alimenta el panel gerencial -->
<div class="lic-layer-modal" id="lic-layer-modal" hidden>
  <div class="lic-layer-card" role="dialog" aria-modal="true" aria-labelledby="lic-layer-title">
    <header>
      <h3 id="lic-layer-title">Capa del dashboard</h3>
      <button type="button" class="lic-layer-close" id="lic-layer-close" aria-label="Cerrar">✕</button>
    </header>
    <p class="lic-layer-hint">
      Elige la capa de GeoServer que alimenta el panel. El cambio aplica al
      dashboard gerencial (no modifica la capa original).
    </p>
    <input
      type="search"
      class="lic-layer-search"
      id="lic-layer-search"
      placeholder="Buscar capa o workspace…"
      autocomplete="off"
    />
    <div class="lic-layer-list" id="lic-layer-list">
      <p class="lic-layer-empty">Cargando capas…</p>
    </div>
    <footer>
      <button type="button" class="lic-layer-cancel" id="lic-layer-cancel">Cancelar</button>
      <button type="button" class="lic-layer-save" id="lic-layer-save" disabled>Guardar</button>
    </footer>
  </div>
</div>

<script>
  import '../../scripts/manager-licencias.js';
</script>
