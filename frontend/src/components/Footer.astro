---
---
<footer>
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="brand-block">
          <img src="/img/logo.png" alt="BSD" class="brand-mark-img" />
          <span class="brand-name">Geoportal</span>
        </div>
        <p>
          Plataforma de demostración con fines ilustrativos. Los datos, cifras y
          nombres mostrados son de ejemplo.
        </p>
      </div>

      <div class="footer-cols">
        <div class="footer-col">
          <h4>Plataforma</h4>
          <a href="#plataforma">Resumen</a>
          <a href="#funciones">Funciones</a>
          <a href="#cobertura">Vista previa</a>
        </div>
        <div class="footer-col">
          <h4>Acceso</h4>
          <a href="/login">Iniciar sesión</a>
          <a href="#funciones">Solicitar cuenta</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span><span class="dot"></span>GEOPORTAL v0.1</span>
      <span>DATUM WGS84 · EPSG:4326</span>
    </div>
  </div>
</footer>

<style>
  footer{
    background:linear-gradient(180deg, #ffffff 0%, var(--navy-50) 100%);
    border-top:1px solid var(--line-200);
    padding:56px 0 28px;
  }
  .footer-top{
    display:flex;justify-content:space-between;gap:40px;flex-wrap:wrap;
    padding-bottom:36px;border-bottom:1px solid var(--line-200);
  }
  .brand-block{display:flex;align-items:center;gap:12px;}
  .brand-mark-img{height:36px;width:auto;object-fit:contain;}
  .brand-name{
    font-family:'Fraunces',serif;font-weight:600;font-size:1.06rem;
    color:var(--navy-900);
  }
  .footer-brand p{
    margin-top:14px;font-size:.83rem;color:var(--ink-400);
    max-width:300px;line-height:1.65;
  }
  .footer-cols{display:flex;gap:60px;flex-wrap:wrap;}
  .footer-col h4{
    font-family:'JetBrains Mono',monospace;font-size:.65rem;
    letter-spacing:.1em;text-transform:uppercase;
    color:var(--ink-400);margin-bottom:16px;
  }
  .footer-col a{
    display:block;font-size:.86rem;color:var(--ink-500);
    margin-bottom:10px;transition:color .15s ease;
  }
  .footer-col a:hover{color:var(--navy-700);}
  .footer-bottom{
    display:flex;justify-content:space-between;align-items:center;
    flex-wrap:wrap;gap:10px;padding-top:24px;
    font-family:'JetBrains Mono',monospace;
    font-size:.68rem;color:var(--ink-400);
  }
  .footer-bottom .dot{
    width:6px;height:6px;border-radius:50%;
    background:var(--navy-600);
    box-shadow:0 0 0 3px var(--navy-100);
    display:inline-block;margin-right:8px;
  }
  @media (max-width:640px){
    .footer-cols{gap:32px;}
  }
</style>