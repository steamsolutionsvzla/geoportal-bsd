---
<footer class="site-footer">
  <div class="wrap">
    <div class="footer-top">
      <div class="footer-brand">
        <div class="brand-block">
          <img src="/img/logo.png" alt="BSD" class="brand-mark-img" />
          <span class="brand-name">Geoportal</span>
        </div>
        <p>
          Plataforma de demostración con fines ilustrativos. Los datos, cifras y
          nombres mostrados son de ejemplo.
        </p>
      </div>

      <div class="footer-cols">
        <div class="footer-col">
          <h4>Plataforma</h4>
          <a href="#plataforma">Resumen</a>
          <a href="#funciones">Funciones</a>
          <a href="#cobertura">Vista previa</a>
        </div>
        <div class="footer-col">
          <h4>Acceso</h4>
          <a href="/login">Iniciar sesión</a>
          <a href="#funciones">Solicitar cuenta</a>
        </div>
      </div>
    </div>

    <div class="footer-bottom">
      <span class="footer-credit">
        Desarrollado por <strong>Steam Solutions</strong>
      </span>
    </div>
  </div>
</footer>

<style>
  .site-footer{
    background:linear-gradient(180deg, #ffffff 0%, var(--navy-50) 100%);
    border-top:1px solid var(--line-200);
    padding:20px 0 14px;
  }
  .footer-top{
    display:flex;justify-content:space-between;gap:40px;flex-wrap:wrap;
  }
  .brand-block{display:flex;align-items:center;gap:12px;}
  .brand-mark-img{height:32px;width:auto;object-fit:contain;}
  .brand-name{
    font-family:'Fraunces',serif;font-weight:600;font-size:1rem;
    color:var(--navy-900);
  }
  .footer-brand p{
    margin-top:8px;font-size:.78rem;color:var(--ink-400);
    max-width:300px;line-height:1.55;
  }
  .footer-cols{display:flex;gap:60px;flex-wrap:wrap;}
  .footer-col h4{
    font-family:'JetBrains Mono',monospace;font-size:.65rem;
    letter-spacing:.1em;text-transform:uppercase;
    color:var(--ink-400);margin-bottom:10px;
  }
  .footer-col a{
    display:block;font-size:.82rem;color:var(--ink-500);
    margin-bottom:6px;transition:color .15s ease;
  }
  .footer-col a:hover{color:var(--navy-700);}

  .footer-bottom{
    display:flex;
    justify-content:flex-end;
    align-items:center;
    margin-top:16px;
    padding-top:12px;
    border-top:1px solid var(--line-200);
  }
  .footer-credit{
    font-family:'JetBrains Mono',monospace;
    font-size:.62rem;
    letter-spacing:.04em;
    color:var(--ink-400);
  }
  .footer-credit strong{
    color:var(--navy-700);
    font-weight:600;
  }

  @media (max-width:640px){
    .footer-cols{gap:32px;}
    .footer-bottom{justify-content:flex-start;}
  }
</style>