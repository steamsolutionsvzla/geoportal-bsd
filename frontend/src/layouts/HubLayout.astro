---
import '../styles/global.css';
import '../styles/nav.css';
import '../styles/hub.css';
// Fuentes self-hosted (sin Google Fonts / sin internet)
import '@fontsource/fraunces/400.css';
import '@fontsource/fraunces/500.css';
import '@fontsource/fraunces/600.css';
import '@fontsource/fraunces/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';

interface Props {
  title?: string;
  subtitle?: string;
}

const {
  title = 'Hub · BSD Geoportal',
  subtitle = 'Selecciona el modo de operación'
} = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={subtitle} />
  <link rel="icon" type="image/svg+xml" href="/img/favicon.svg" />

  <script>
  import '../scripts/session.js';   
</script>
</head>

<body class="hub-body">
  <div class="hub-root">

    <!-- ============== TOPBAR (misma marca que Nav) ============== -->
    <header class="hub-topbar">
      <div class="hub-topbar-inner">
        <a href="/" class="brand-block">
          <img src="/img/logo.png" alt="BSD" class="brand-mark-img" />
          <span class="brand-name">Geoportal</span>
        </a>

        <div class="hub-topbar-actions">
          <div class="hub-user-chip" title="Sesión iniciada">
            <div class="hub-user-info">
              <span class="hub-u-name">Juan Fernández</span>
              <span class="hub-u-role">Dpto. de Datos Digitales</span>
            </div>
            <div class="hub-avatar">JF</div>
          </div>
          <button
            type="button"
            class="hub-icon-btn hub-logout-btn"
            title="Cerrar sesión"
            aria-label="Cerrar sesión"
            onclick="cerrarSesion()"
          >
            <svg viewBox="0 0 24 24" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
              <polyline points="16 17 21 12 16 7"></polyline>
              <line x1="21" y1="12" x2="9" y2="12"></line>
            </svg>
          </button>
        </div>
      </div>
    </header>

    <main class="hub-main">
      <slot />
    </main>

    <slot name="footer" />

  </div>

  <script is:inline>
    if (!localStorage.getItem('auth_token')) {
      window.location.href = '/login';
    }
    window.cerrarSesion = () => {
      localStorage.removeItem('auth_session');
       localStorage.removeItem('auth_token'); 
      window.location.href = '/login';
    };
  </script>
</body>
</html>