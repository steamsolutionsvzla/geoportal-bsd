# Copiar a frontend/.env antes de compilar (pnpm build).
# Astro expone al navegador SOLO las variables con prefijo PUBLIC_.

# Clave publica de la CDN de CARTO: habilita el zoom profundo (z10+) de la
# vista Clara en modo online. Sin clave, Clara se queda en z9 (relieve Esri).
# Para la generacion offline se reusa como CARTO_KEY:
#   py scripts/generate-offline-tiles.py --layers clara-deep --carto-key <esta clave>
PUBLIC_CARTO_KEY=

# true → el build usa los fondos PMTiles locales (public/tiles/*.pmtiles):
#        mapa sin internet. Requiere haber generado TODOS los pmtiles
#        (clara, clara-deep, satelite, satelite-labels).
# false/ausente → modo online (Esri Terrain + CARTO), como hoy.
PUBLIC_OFFLINE_TILES=false
