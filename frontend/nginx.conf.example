# =============================================================
# Geoportal BSD - Nginx (plantilla)
# -------------------------------------------------------------
# Copiar como /etc/nginx/sites-available/geoportal-bsd,
# ajustar server_name / root / puertos y enlazar:
#   ln -s /etc/nginx/sites-available/geoportal-bsd \
#         /etc/nginx/sites-enabled/geoportal-bsd
#   nginx -t && systemctl reload nginx
# =============================================================

server {
    listen 80;
    server_name geoportal.ejemplo.com;

    # Carpeta generada por `pnpm build` (frontend/dist)
    root /var/www/geoportal-bsd;
    index index.html;

    client_max_body_size 50m;

    # API FastAPI (backend en Docker, puerto host 8000)
    location /api/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
    }

    # GeoServer (capas raster/WMS y consola), puerto host 8081
    location /geoserver/ {
        proxy_pass http://127.0.0.1:8081/geoserver/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 180s;
    }

    # Assets con hash de Astro
    location /_astro/ {
        expires 30d;
        add_header Cache-Control "public, immutable";
    }

    # Rutas estáticas de Astro (build.format = 'directory')
    location / {
        try_files $uri $uri/ /index.html;
    }
}
