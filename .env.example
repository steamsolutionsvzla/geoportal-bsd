# =============================================================
# Geoportal BSD - Variables de entorno
# -------------------------------------------------------------
# Copiar este archivo como .env en la raíz del proyecto:
#     cp .env.example .env
# y cambiar TODOS los valores marcados con CAMBIA_ESTA_CLAVE.
# El .env real nunca se sube al repositorio.
# =============================================================

# ---------- Backend (FastAPI) ----------
PORT=8000
HOST=0.0.0.0
DEBUG=False
BACKEND_PORT=8000
# Interfaz del host donde se publican los puertos de Docker.
# 127.0.0.1 = solo accesible desde el propio servidor (recomendado con Nginx).
BIND_ADDR=127.0.0.1

# ---------- PostgreSQL / PostGIS ----------
# host.docker.internal = el host donde corre PostgreSQL (Docker Desktop/Linux).
# Si PostgreSQL está en un contenedor de la misma red, usar el nombre del servicio.
DB_HOST=host.docker.internal
DB_PORT=5433
DB_NAME=petroleo_db
DB_USER=geoportal
DB_PASSWORD=CAMBIA_ESTA_CLAVE

# ---------- GeoServer ----------
GEOSERVER_URL=http://geoserver-bsd:8080/geoserver
GEOSERVER_USER=admin
GEOSERVER_PASSWORD=CAMBIA_ESTA_CLAVE
GEOSERVER_WORKSPACE=Petróleo_y_gas
GEOSERVER_PORT=8081
GEOSERVER_JNDI_NAME=jdbc/PostGISDB

# ---------- Odoo (login del geoportal) ----------
# Odoo debe exponer POST {ODOO_URL}/api/geoportal/v1/login
ODOO_URL=https://odoo.ejemplo.com
ODOO_DB=odoo_db
# SOLO desarrollo. En producción siempre False.
AUTH_MOCK=False

# ---------- MapTiler (opcional, endpoint /api/config) ----------
MAPTILER_KEY=
