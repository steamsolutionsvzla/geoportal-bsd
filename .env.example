# ======================================================================
# Geoportal BSD — plantilla de variables de entorno.
# Copia este archivo a `.env` y rellena los valores. NUNCA subas el .env.
# ======================================================================

# --- Servidor ---
PORT=8000
HOST=localhost
# /docs y tracebacks solo con DEBUG=True (desarrollo). En producción: False.
DEBUG=False
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# Archivo de log rotativo (10 MB x 5) ADEMÁS de stdout. Vacío = solo stdout
# (visible con `docker compose logs backend`). En Docker use la ruta montada:
# LOG_FILE=/app/storage/logs/app.log
LOG_FILE=

# --- CORS: orígenes que sirven el frontend, separados por coma ---
# Dev: http://localhost:4321
# Producción: https://geobsd.steamsolutions.tech
CORS_ORIGINS=http://localhost:4321

# --- Base de datos (PostGIS en el host, visto desde el contenedor) ---
DB_HOST=host.docker.internal
DB_PORT=5433
DB_NAME=petroleo_db
DB_USER=postgres
DB_PASSWORD=

# --- GeoServer (contenedor geoserver-bsd dentro de geoportal-net) ---
GEOSERVER_URL=http://geoserver-bsd:8080/geoserver
GEOSERVER_USER=
GEOSERVER_PASSWORD=
GEOSERVER_WORKSPACE=Petróleo_y_gas

# --- Odoo (autenticación del geoportal; el backend hace de proxy) ---
ODOO_URL=
ODOO_DB=bsd
# SOLO desarrollo local (simula perfiles, ignora la BD de sesiones).
# NUNCA True en producción: AUTH_MOCK=True autentica con tokens fijos.
AUTH_MOCK=False
